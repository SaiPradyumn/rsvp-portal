* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', sans-serif;
  overflow: hidden;
}

/* Container */
.container {
  display: flex;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(135deg, #1a1a1a 0%, #2d2416 100%);
  position: relative;
}

/* Shimmer Overlay */
.shimmer-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    45deg,
    transparent 30%,
    rgba(255, 215, 0, 0.03) 50%,
    transparent 70%
  );
  background-size: 200% 200%;
  animation: shimmer 8s ease-in-out infinite;
  pointer-events: none;
  z-index: 1;
}

@keyframes shimmer {
  0%, 100% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
}

/* Left Panel - 30% */
.left-panel {
  width: 30%;
  background: linear-gradient(135deg, 
    #fef3e2 0%,
    #fce4d8 25%,
    #f4d5c8 50%,
    #eed9c8 75%,
    #fef3e2 100%
  );
  background-size: 200% 200%;
  animation: gradientShift 10s ease infinite;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rem;
  padding: 2rem;
  position: relative;
  z-index: 2;
  box-shadow: 4px 0 20px rgba(184, 134, 11, 0.3);
}

.left-panel::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 20% 50%, rgba(255, 215, 0, 0.15) 0%, transparent 50%),
              radial-gradient(circle at 80% 80%, rgba(218, 165, 32, 0.15) 0%, transparent 50%);
  pointer-events: none;
}

@keyframes gradientShift {
  0%, 100% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
}

.title-section {
  text-align: center;
  margin-bottom: 2rem;
  position: relative;
  z-index: 1;
}

.title {
  font-size: 2.8rem;
  font-family: Georgia, serif;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 50%, #FFD700 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 0.5rem;
  text-shadow: 0 2px 10px rgba(218, 165, 32, 0.3);
  animation: titleGlow 3s ease-in-out infinite;
}

@keyframes titleGlow {
  0%, 100% {
    filter: drop-shadow(0 0 8px rgba(255, 215, 0, 0.4));
  }
  50% {
    filter: drop-shadow(0 0 15px rgba(218, 165, 32, 0.6));
  }
}

.subtitle {
  color: #8B6914;
  font-size: 1rem;
  font-weight: 500;
}

/* Buttons */
.btn {
  width: 16rem;
  padding: 1rem 2rem;
  font-size: 1rem;
  font-weight: 600;
  border: none;
  border-radius: 0.75rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  box-shadow: 0 8px 20px rgba(184, 134, 11, 0.25);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  z-index: 1;
}

.btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transition: left 0.5s;
}

.btn:hover::before {
  left: 100%;
}

.btn:hover {
  transform: translateY(-2px) scale(1.05);
  box-shadow: 0 12px 30px rgba(184, 134, 11, 0.4);
}

.btn-primary {
  background: linear-gradient(135deg, #C9A961 0%, #B8860B 50%, #DAA520 100%);
  color: white;
  border: 2px solid #DAA520;
}

.btn-primary:hover {
  background: linear-gradient(135deg, #DAA520 0%, #FFD700 50%, #B8860B 100%);
}

.btn-secondary {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF8DC 100%);
  color: #8B6914;
  border: 2px solid #DAA520;
}

.btn-secondary:hover {
  background: linear-gradient(135deg, #FFF8DC 0%, #FFEFD5 100%);
}

/* Right Panel - 70% */
.right-panel {
  width: 70%;
  background: linear-gradient(135deg, #1a1512 0%, #2d2416 100%);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.right-panel::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 30% 40%, rgba(218, 165, 32, 0.08) 0%, transparent 40%),
    radial-gradient(circle at 70% 60%, rgba(255, 215, 0, 0.05) 0%, transparent 40%);
  pointer-events: none;
}

/* Lottery Machine Container */
.lottery-container {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  perspective: 1000px;
}

.lottery-frame {
  width: 90%;
  max-width: 1100px;
  height: 650px;
  background: linear-gradient(135deg, #2d2416 0%, #1a1512 100%);
  border: 8px solid transparent;
  background-clip: padding-box;
  border-radius: 30px;
  box-shadow: 
    0 0 30px rgba(218, 165, 32, 0.4),
    inset 0 0 40px rgba(0, 0, 0, 0.5);
  position: relative;
  overflow: hidden;
}

.lottery-frame::before {
  content: '';
  position: absolute;
  top: -8px;
  left: -8px;
  right: -8px;
  bottom: -8px;
  background: linear-gradient(135deg, 
    #FFD700 0%, 
    #FFC700 15%, 
    #FFE55C 30%, 
    #FFDF00 45%, 
    #FFD700 50%, 
    #FFEA00 55%, 
    #FFC700 70%, 
    #FFD700 85%, 
    #FFDF00 100%
  );
  border-radius: 30px;
  z-index: -1;
  animation: borderRotate 4s linear infinite;
  box-shadow: 
    0 0 40px rgba(255, 215, 0, 0.8),
    0 0 60px rgba(255, 215, 0, 0.6),
    inset 0 0 20px rgba(255, 223, 0, 0.5);
}

@keyframes borderRotate {
  0% {
    filter: hue-rotate(0deg) brightness(1.2);
  }
  50% {
    filter: hue-rotate(15deg) brightness(1.4);
  }
  100% {
    filter: hue-rotate(0deg) brightness(1.2);
  }
}

.lottery-window {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 95%;
  height: 92%;
  overflow: hidden;
  border-radius: 15px;
  background: rgba(0, 0, 0, 0.3);
  box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.8);
}

.lottery-reel {
  display: flex;
  flex-direction: column;
  animation: lotteryRotate 40s linear infinite;
}

.lottery-reel:hover {
  animation-play-state: paused;
}

@keyframes lotteryRotate {
  0% {
    transform: translateY(0);
  }
  100% {
    transform: translateY(-33.333%);
  }
}

.lottery-item {
  min-height: 598px;
  height: 598px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.lottery-image {
  width: calc(100% - 40px);
  height: calc(100% - 40px);
  margin: 20px;
  object-fit: cover;
  border-radius: 25px;
  box-shadow: 
    0 0 40px rgba(218, 165, 32, 0.2),
    0 0 20px rgba(255, 215, 0, 0.15),
    inset 0 0 30px rgba(218, 165, 32, 0.05);
  border: 15px solid;
  border-image: linear-gradient(135deg, 
    #E5E4E2 0%, 
    #C0C0C0 15%, 
    #F5F5F5 30%, 
    #D3D3D3 45%, 
    #E8E8E8 50%, 
    #C9C9C9 55%, 
    #FFFFFF 70%, 
    #BFBFBF 85%, 
    #E5E4E2 100%
  ) 1;
  border-radius: 25px;
  display: block;
  position: relative;
}

/* Add metallic shine to platinum frame */
.lottery-image::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, 
    transparent, 
    rgba(255, 255, 255, 0.5), 
    transparent
  );
  animation: frameShine 4s ease-in-out infinite;
  pointer-events: none;
  border-radius: 25px;
}

@keyframes frameShine {
  0%, 100% {
    left: -100%;
  }
  50% {
    left: 100%;
  }
}

@keyframes frameShine {
  0%, 100% {
    left: -100%;
  }
  50% {
    left: 100%;
  }
}

/* Lottery Shine Effect */
.lottery-shine {
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 215, 0, 0.3) 50%,
    transparent 100%
  );
  animation: shine 3s ease-in-out infinite;
  pointer-events: none;
}

@keyframes shine {
  0%, 100% {
    left: -100%;
  }
  50% {
    left: 100%;
  }
}

/* Modal */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 1rem;
}

.modal-content {
  background: linear-gradient(135deg, #FFF8DC 0%, #FFEFD5 100%);
  border-radius: 1.5rem;
  padding: 2rem;
  max-width: 28rem;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 
    0 25px 50px rgba(0, 0, 0, 0.5),
    0 0 30px rgba(218, 165, 32, 0.3);
  border: 3px solid;
  border-image: linear-gradient(135deg, #B8860B, #DAA520, #B8860B) 1;
}

.modal-wide {
  max-width: 42rem;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 2px solid rgba(218, 165, 32, 0.3);
}

.modal-title {
  font-size: 2rem;
  font-family: Georgia, serif;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.close-btn {
  background: none;
  border: none;
  color: #8B6914;
  cursor: pointer;
  padding: 0;
  display: flex;
  align-items: center;
  transition: all 0.3s;
}

.close-btn:hover {
  color: #B8860B;
  transform: rotate(90deg);
}

/* Form */
.form {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.form-group {
  display: flex;
  flex-direction: column;
}

.form-label {
  display: block;
  font-size: 0.875rem;
  font-weight: 600;
  color: #8B6914;
  margin-bottom: 0.5rem;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 0.75rem 1rem;
  border: 2px solid #DAA520;
  border-radius: 0.5rem;
  font-size: 1rem;
  font-family: inherit;
  background: white;
  transition: all 0.3s;
}

.form-input:focus,
.form-textarea:focus {
  outline: none;
  border-color: #B8860B;
  box-shadow: 0 0 0 3px rgba(218, 165, 32, 0.2);
}

.form-textarea {
  resize: vertical;
}

/* FAQ */
.faq-container {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.faq-item {
  margin-bottom: 0;
  padding: 1rem;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 0.75rem;
  border-left: 4px solid #DAA520;
}

.faq-question {
  font-size: 1.125rem;
  font-weight: 700;
  color: #8B6914;
  margin-bottom: 0.5rem;
}

.faq-answer {
  color: #5d4e37;
  line-height: 1.6;
}